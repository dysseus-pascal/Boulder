<?xml version="1.0" encoding="utf-8"?>
<!-- Der Balken unter einer Zahl.
     Die leere Spur ist die Linienfarbe, der volle Teil der Akzent. Ein
     eigenes Zeichenwerk, weil der Systembalken die Akzentfarbe des Telefons
     nimmt - und die ist auf einem Material-You-Geraet irgendein Rosa. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/ks_w_linie" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/ks_w_akzent" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
